# =======================================================
# AL BARI ORGANIZATION HUB - ENVIRONMENT CONFIGURATION
# =======================================================

# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Drive API v3 Configuration
# Required Scope: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token-here
DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# Application Configuration
APP_NAME="Al Bari Organization Hub"
FIRST_ADMIN_EMAIL=admin@albari.org

# Set to "true" for offline development or testing without Google credentials.
# Set to "false" in real production with Google OAuth credentials.
MOCK_DRIVE=true
